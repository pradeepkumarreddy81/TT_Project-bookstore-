# Database configuration
DB_URL=jdbc:mysql://localhost:3306/bookstore_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_local_db_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_base64_encoded
JWT_EXPIRATION_MS=86400000

# CORS & Server configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Seed Administrator Account (ADMIN_PASSWORD is required without default in prod)
ADMIN_EMAIL=admin@bookstore.com
ADMIN_PASSWORD=Admin@123

# Hibernate Schema Auto-generation (update for initial deploy, validate for production)
DDL_AUTO=update
